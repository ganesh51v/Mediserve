{
  "name": "mediserve",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:client\"",
    "dev:client": "vite",
    "dev:api": "tsx --watch server/index.ts",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "lint": "eslint",
    "test": "tsx --test tests/unit/authFlow.test.ts tests/unit/adherence.test.ts tests/unit/alerts.test.ts tests/unit/auditAndSecurityFixes.test.ts tests/unit/ids.test.ts tests/unit/mealAware.test.ts tests/unit/pwaAndResponsive.test.ts tests/unit/supabase.test.ts tests/integration/caregiverFlow.test.ts tests/integration/routes.test.ts tests/integration/v1ApiAndChecklist.test.ts",
    "test:auth": "tsx --test tests/unit/authFlow.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.2",
    "@clerk/react": "^6.18.1",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^4.3.4",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.5",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "jose": "^6.2.13",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vite": "^6.3.5"
  },
  "devDependencies": {
    "eslint": "^9"
  }
}
