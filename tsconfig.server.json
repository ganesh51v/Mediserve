{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "dist",
    "rootDir": ".",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["server", "src/lib"],
  "exclude": [
    "node_modules",
    "dist",
    "src/lib/actions.ts",
    "src/lib/auth.ts",
    "src/lib/clerk.ts"
  ]
}
